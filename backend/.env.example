# ARC-NOMADE Backend Environment Variables
PROJECT_NAME="ARC-NOMADE API"
SECRET_KEY="arc_nomade_super_secret_jwt_key_2026_voyage_secure_token"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL="sqlite:///./arc_nomade.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arcnomade_db"

# OpenRouter AI (100% Free Tier Compatible)
# Get a free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# AI Provider selection: "auto", "openrouter", "gemini", "mock"
AI_PROVIDER="auto"

# Gemini AI (Optional alternative)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Mapbox (Optional - falls back to OpenStreetMap interactive map if omitted)
MAPBOX_ACCESS_TOKEN=""

# Weather (Optional - Open-Meteo free API is used by default)
OPENWEATHER_API_KEY=""
